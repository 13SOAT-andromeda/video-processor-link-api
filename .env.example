# copie para .env e exporte (ou use `make run`, que já carrega)
PORT=8080
BASE_URL=http://localhost:8080
JWT_SECRET=dev-secret-change-me

# LocalStack (deixe AWS_ENDPOINT_URL vazio para AWS real)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DYNAMO_LINKS_TABLE=Links
DYNAMO_EVENTS_TABLE=LinkEvents
S3_BUCKET=video-processing-bucket
STATUS_QUEUE_URL=http://localhost:4566/000000000000/video-processing-status-queue
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:notification-topic
# consumer que confirma o upload a partir do evento S3 ObjectCreated (fan-out
# SNS video-upload-events -> esta fila) — substitui o antigo PUT /links/:id/upload
UPLOAD_CONFIRMATION_QUEUE_URL=http://localhost:4566/000000000000/video-upload-confirmation-queue

# Valores reais na AWS (DynamoDB provisionado por iac-video-processor-data;
# bucket de vídeo e filas provisionados por iac-video-processor-infra —
# o bucket é único, compartilhado com o processing-worker):
#   DYNAMO_LINKS_TABLE=video-processor-links-db-prod
#   DYNAMO_EVENTS_TABLE=video-processor-link-events-db-prod
#   S3_BUCKET=<output video_processor_bucket_name do iac-video-processor-infra>
#   STATUS_QUEUE_URL=<output video_processing_status_queue_url do iac-video-processor-infra>
#   NOTIFICATION_TOPIC_ARN=<output notification_events_topic_arn do iac-video-processor-infra>
#   UPLOAD_CONFIRMATION_QUEUE_URL=<output video_upload_confirmation_queue_url do iac-video-processor-infra>
#   (o template PROCESSING_FAILED precisa estar cadastrado no notification-service)

# users-api ainda não está no ar: true = mock; false = HTTP no cluster
USE_USER_SVC_MOCK=true
USERS_BASE_URL=http://video-processor-users-api-svc.default.svc.cluster.local

# Datadog APM — vazio (padrão) = tracer desligado, nenhuma tentativa de conexão.
# Em produção (pod EKS), DD_AGENT_HOST vem da Downward API (status.hostIP) —
# o agent roda como DaemonSet no cluster (iac-video-processor-infra).
# Para testar localmente com um agent de verdade, defina DD_AGENT_HOST=127.0.0.1
# e suba `docker run -e DD_API_KEY=<sua-chave> -p 8126:8126 gcr.io/datadoghq/agent:7`.
DD_AGENT_HOST=
DD_SERVICE=video-processor-link-api
DD_ENV=dev
DD_VERSION=dev
