# copie para .env e exporte (ou use `make run`, que já carrega)
PORT=8080
BASE_URL=http://localhost:8080
JWT_SECRET=dev-secret-change-me

# LocalStack (deixe AWS_ENDPOINT_URL vazio para AWS real)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DYNAMO_LINKS_TABLE=Links
DYNAMO_EVENTS_TABLE=LinkEvents
S3_BUCKET=video-processing-bucket
STATUS_QUEUE_URL=http://localhost:4566/000000000000/video-processing-status-queue
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:notification-topic

# users-service ainda não existe: true = mock; false = HTTP no cluster
USE_USER_SVC_MOCK=true
USERS_BASE_URL=http://users-service.default.svc.cluster.local
