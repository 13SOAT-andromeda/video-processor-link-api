# Copie para .env.host (gitignored) e preencha com os valores reais da sessão
# AWS Academy atual — todos vêm de outputs do Terraform.
#
# BASE_URL          <- output api_endpoint do iac-video-processor-gateway
# STATUS_QUEUE_URL  <- output video_processing_status_queue_url do iac-video-processor-infra
# NOTIFICATION_TOPIC_ARN <- output notification_events_topic_arn do iac-video-processor-infra
# DD_VERSION        <- tag da imagem publicada no ECR (git sha curto, por exemplo)

BASE_URL=https://REPLACE.execute-api.us-east-1.amazonaws.com
STATUS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/REPLACE_ACCOUNT_ID/video-processing-status-queue-prod
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:REPLACE_ACCOUNT_ID:notification-events-topic-prod
DD_VERSION=REPLACE_ME
